# =============================================================================
# NetAI Digital Twin — Iceberg Lakehouse Stack Environment Variables
# =============================================================================
#
# USAGE:
#   cp example.env .env
#   # Edit .env with your own credentials, then:
#   docker compose up -d --build
#
# IMPORTANT: All credentials below must be consistent across services.
#   MinIO root credentials (MINIO_ROOT_USER/PASSWORD) must match the
#   AWS_ACCESS_KEY_ID/SECRET_ACCESS_KEY used by Polaris, Trino, and the API.
#
# LINE ENDINGS: This file MUST use LF. Enforced by .gitattributes.
# =============================================================================

# ── MinIO (S3-compatible Object Storage) ─────────────────────────────────────
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin1234

# ── AWS/S3 Credentials (shared across Polaris, Trino, Lakehouse API) ────────
# MUST match MINIO_ROOT_USER/PASSWORD above
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=admin1234

# ── Apache Polaris (Iceberg REST Catalog) ────────────────────────────────────
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=s3cr3t00

# ── Trino ────────────────────────────────────────────────────────────────────
# Host path for Trino spill/temp data.
# NOTE: The Iceberg docker-compose now uses a named volume (trino_user_data)
# instead of this bind mount for Windows Docker Desktop compatibility.
# This variable is kept for backward compatibility on Linux direct mounts.
USER_DATA_PATH=/tmp/trino_data

# ── Iceberg Lakehouse Configuration ─────────────────────────────────────────
ICEBERG_WAREHOUSE=iceberg2
ICEBERG_NAMESPACE=netai

# ── S3 Bucket Configuration ─────────────────────────────────────────────────
S3_BUCKET=warehouse2
S3_USD_PREFIX=usd/world_prims/
