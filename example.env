# =============================================================================
# NetAI-Digital-Twin — Environment Variables
# =============================================================================
# Copy this file:  cp example.env .env
# Then edit credentials as needed.
#
# IMPORTANT: MinIO requires username >= 5 chars, password >= 8 chars.
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY MUST match MINIO_ROOT_USER /
# MINIO_ROOT_PASSWORD so that Polaris, Trino, and the API can all access MinIO.
#
# LINE ENDINGS: This file MUST use LF (Unix) line endings.
#   .gitattributes enforces this automatically on checkout.
#   Windows users: if you create .env manually, ensure your editor saves as LF.
#
# PORT MAPPING: Default ports are chosen to avoid common conflicts.
#   See the Port Map section below for the full allocation table.
# =============================================================================

# -- MinIO (S3-compatible storage) --
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin1234
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# -- S3 credentials (must match MinIO root user) --
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=admin1234
AWS_REGION=us-east-1

# -- Apache Polaris (Iceberg REST Catalog) --
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=s3cr3t00
POLARIS_API_PORT=8181
POLARIS_MGMT_PORT=8182

# -- Trino --
TRINO_PORT=8900
TRINO_USER=trino

# -- Iceberg --
ICEBERG_WAREHOUSE=iceberg2
ICEBERG_NAMESPACE=static_db
ICEBERG_TABLE_NAME=static_prims

# -- S3 Bucket --
S3_BUCKET=warehouse2
S3_USD_PREFIX=usd/world_prims/

# -- Lakehouse API (FastAPI Middleware) --
API_PORT=8100
DEBUG=false

# -- Spark --
SPARK_UI_PORT=4040
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8180
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2

# -- Web Dashboard --
DASHBOARD_PORT=3000

# =============================================================================
# Port Map (host ports — all configurable above)
# =============================================================================
#   Service           Host Port   Container Port   Variable
#   ─────────────────────────────────────────────────────────
#   MinIO S3 API      9000        9000             MINIO_API_PORT
#   MinIO Console     9001        9001             MINIO_CONSOLE_PORT
#   Polaris REST      8181        8181             POLARIS_API_PORT
#   Polaris Mgmt      8182        8182             POLARIS_MGMT_PORT
#   Trino SQL/UI      8900        8080             TRINO_PORT
#   Lakehouse API     8100        8000             API_PORT
#   Spark App UI      4040        4040             SPARK_UI_PORT
#   Spark Master      7077        7077             SPARK_MASTER_PORT
#   Spark Master UI   8180        8080             SPARK_MASTER_UI_PORT
#   Spark Worker UI   (auto)      8081             (internal only)
#   Dashboard (nginx) 3000        80               DASHBOARD_PORT
#
# If a port conflicts with another service on your host, change the
# corresponding *_PORT variable.  Container-internal ports never change.
# =============================================================================
